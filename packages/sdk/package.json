{
  "name": "phase-analytics",
  "version": "0.0.40",
  "description": "Privacy focused mobile analytics SDK",
  "author": "Phase Analytics",
  "license": "AGPL-3.0-only",
  "keywords": [
    "mobile",
    "analytics",
    "expo",
    "react-native",
    "typescript",
    "privacy"
  ],
  "sideEffects": false,
  "exports": {
    "./expo": {
      "types": "./dist/expo/index.d.ts",
      "default": "./dist/expo/index.js"
    },
    "./react-native": {
      "types": "./dist/react-native/index.d.ts",
      "default": "./dist/react-native/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsgo --noEmit",
    "test": "bun test test/",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.0.0",
    "react-native-device-info": ">=10.0.0",
    "react-native-localize": ">=3.0.0",
    "react-native": ">=0.70.0",
    "react": ">=18.0.0",
    "@react-native-community/netinfo": ">=11.0.0",
    "expo-device": ">=6.0.0",
    "expo-application": ">=5.0.0",
    "expo-localization": ">=14.0.0",
    "expo-router": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@react-native-community/netinfo": {
      "optional": true
    },
    "expo-device": {
      "optional": true
    },
    "expo-application": {
      "optional": true
    },
    "expo-localization": {
      "optional": true
    },
    "expo-router": {
      "optional": true
    },
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "react-native-device-info": {
      "optional": true
    },
    "react-native-localize": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native-community/netinfo": "^12.0.1",
    "@types/react": "^19.1.8",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "expo-router": "^6.0.19",
    "fflate": "^0.8.2",
    "tsup": "^8.3.5",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Phase-Analytics/Phase.git"
  },
  "homepage": "https://phase.sh",
  "bugs": {
    "url": "https://github.com/Phase-Analytics/Phase/issues"
  }
}
