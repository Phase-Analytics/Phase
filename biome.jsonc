{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "files": {
    "includes": [
      "!**/public/openanalytics-v0.8.0.js",
      "!**/public/geo",
      "!**/drizzle",
      "!**/.next",
      "!**/dist",
      "!**/build",
      "!**/node_modules",
      "!**/packages/phase-unity",
      "!**/apps/web/src/components/charts",
      // apps/mobile keeps its own (double-quote) style and is typechecked in CI.
      "!**/apps/mobile",
      "!.agents",
      "!.claude",
      "!.pi",
      "!bun.lock"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5"
    }
  },
  // Ultracite 8 enables rules the previous preset kept off, and new style
  // rules that would rewrite most existing files. Keep the established
  // conventions; key order also matters for serialized output.
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off",
        "useSortedPackageJson": "off",
        // Reordering declarations can flip shorthand/longhand precedence.
        "useSortedProperties": "off"
      }
    }
  },
  "linter": {
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "noUselessCatchBinding": "off"
      },
      "correctness": {
        "noUndeclaredDependencies": "off"
      },
      "suspicious": {
        "noUnknownAtRules": "off",
        "noUnnecessaryConditions": "off",
        // Flags plain boolean state (`{isLoading && <Spinner />}`) and even
        // ternaries without type information; noise, not a leaked-render check.
        "noLeakedRender": "off",
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["log", "warn", "error"]
          }
        }
      },
      "style": {
        "useFilenamingConvention": "off",
        "noMagicNumbers": "off",
        "noIncrementDecrement": "off",
        "useDestructuring": "off",
        // Only recognizes `cause` as the 2nd constructor argument; the custom
        // errors here take (status | kind, message, ...).
        "useErrorCause": "off",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": { "style": "type" }
        }
      },
      "performance": {
        "noBarrelFile": "off",
        "noAwaitInLoops": "off",
        // React Compiler memoizes inline handlers.
        "noJsxPropsBind": "off"
      }
    }
  }
}
