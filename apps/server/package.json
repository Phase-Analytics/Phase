{
  "name": "server",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "check": "bunx ultracite fix --unsafe",
    "typecheck": "tsc --noEmit",
    "auth:generate": "bunx @better-auth/cli@latest generate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "bun test src"
  },
  "dependencies": {
    "@opencoredev/domain-sdk": "0.2.0",
    "@aws-sdk/client-s3": "^3.1150.0",
    "@elysiajs/cors": "^1.4.2",
    "@phase/shared": "workspace:*",
    "@better-auth/expo": "1.6.24",
    "@polar-sh/better-auth": "1.8.4",
    "@polar-sh/sdk": "^0.49.0",
    "@sinclair/typebox": "^0.34.52",
    "better-auth": "1.6.24",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "ioredis": "^5.11.1",
    "isbot": "^5.2.2",
    "maxmind": "^5.0.7",
    "nanoid": "^6.0.2",
    "node-sql-parser": "^5.4.0",
    "pg": "^8.23.1",
